{
  "name": "flickfetch",
  "version": "2.1.7",
  "description": "Flick Fetch",
  "author": "Jessie Albert Regualos",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "start": "npm run build && electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "build:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/services/monitor-service.cjs && node --check electron/services/monitor-api.cjs && node --check electron/services/review-queue-policy.cjs && node --check electron/services/tool-manager.cjs && node --check electron/services/download-service.cjs && node --check electron/services/spotify-service.cjs && node --check electron/services/japanese.cjs && node --check electron/services/preview-service.cjs && node --check electron/services/page-sniffer.cjs && node --check electron/services/rendered-sniffer.cjs && node --check electron/services/legacy-settings.cjs && node --check electron/services/window-state.cjs && node --check electron/services/taskbar-identity.cjs && node --check build/afterPack.cjs",
    "test": "node --test"
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "lucide-react": "^1.65.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.regualos.flickfetch",
    "productName": "FlickFetch",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [ "en-US" ],
    "afterPack": "build/afterPack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "FlickFetch-${version}-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "FlickFetch-${version}-${arch}-Portable.${ext}"
    },
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "COPYRIGHT.txt",
        "to": "COPYRIGHT.txt"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
