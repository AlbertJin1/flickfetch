{
  "name": "flickfetch",
  "version": "2.1.0",
  "description": "FlickFetch desktop media downloader built with React, Electron, and Tailwind CSS.",
  "author": "Jessie Albert Regualos",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "start": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/services/tool-manager.cjs && node --check electron/services/download-service.cjs && node --check electron/services/spotify-service.cjs && node --check electron/services/legacy-settings.cjs",
    "test": "node --test"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "lucide-react": "^1.65.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.regualos.flickfetch",
    "productName": "FlickFetch",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "FlickFetch-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "FlickFetch-${version}-${arch}-Portable.${ext}"
    },
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "COPYRIGHT.txt",
        "to": "COPYRIGHT.txt"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
