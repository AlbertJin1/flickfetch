<Application x:Class="FlickFetch.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="Background" Value="#F4F6FB" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#778198" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#7B8499" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="BorderBrush" Value="#DDE3EF" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#48536A" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#5B5CE2" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#5B5CE2" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#494ACB" />
      <Setter Property="BorderBrush" Value="#494ACB" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#3F4A60" />
      <Setter Property="BorderBrush" Value="#DDE3EF" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#69758C" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#5B5CE2" />
      <Setter Property="Background" Value="#E6EAF3" />
      <Setter Property="Height" Value="6" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F7F8FE" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F1FF" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5B5CE2" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F0F1FF" />
    <SolidColorBrush x:Key="InkBrush" Color="#172033" />
    <SolidColorBrush x:Key="MutedBrush" Color="#778198" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2E7F0" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F8F9FC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#24A579" />
  </Application.Resources>
</Application>
