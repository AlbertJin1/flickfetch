<Window x:Class="FlickFetch.SpotifyPlaylistWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify Playlist Review — FlickFetch" Width="1280" Height="830" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Opened="Window_Loaded">
  <Grid Margin="22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
      <Border Width="54" Height="54" CornerRadius="16" Background="#172A22">
        <TextBlock Text="♫" FontSize="27" FontWeight="Bold" Foreground="#58D68D" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
        <TextBlock Text="Playlist match review" FontSize="21" FontWeight="Bold" />
        <TextBlock x:Name="PlaylistNameText" Text="Spotify playlist" FontSize="13" FontWeight="SemiBold" Foreground="#4D5A70" />
        <TextBlock x:Name="PlaylistMetaText" Text="Spotify · tracks" FontSize="10.5" Foreground="#818CA0" />
      </StackPanel>
      <Button Grid.Column="2" Classes="secondary" Content="↗  Open playlist" VerticalAlignment="Center" Click="OpenPlaylist_Click" />
    </Grid>

    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E7F0" BorderThickness="1" CornerRadius="14" Padding="15">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Audio-first YouTube matching" FontSize="13" FontWeight="Bold" />
          <TextBlock Text="Matches are suggestions for review. Check the title, artist, and source before adding any link to your queue." FontSize="10.5" Foreground="#778198" />
        </StackPanel>
        <Button x:Name="FindMatchesButton" Grid.Column="1" Classes="primary" Content="Find YouTube matches" Click="FindMatches_Click" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E7F0" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#F8F9FC" BorderBrush="#E9EDF4" BorderThickness="0,0,0,1" Padding="14,11">
          <Grid ColumnDefinitions="38,2*,1.2*,1.2*,70,2.6*,130" ColumnSpacing="10">
            <TextBlock Text="#" Classes="eyebrow" />
            <TextBlock Grid.Column="1" Text="TRACK TITLE" Classes="eyebrow" />
            <TextBlock Grid.Column="2" Text="ARTIST" Classes="eyebrow" />
            <TextBlock Grid.Column="3" Text="ALBUM / SHOW" Classes="eyebrow" />
            <TextBlock Grid.Column="4" Text="LENGTH" Classes="eyebrow" />
            <TextBlock Grid.Column="5" Text="BEST YOUTUBE MATCH" Classes="eyebrow" />
            <TextBlock Grid.Column="6" Text="MATCH SCORE" Classes="eyebrow" />
          </Grid>
        </Border>
        <ListBox x:Name="TracksGrid" Grid.Row="1" SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#EEF1F6" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid ColumnDefinitions="38,2*,1.2*,1.2*,70,2.6*,130" ColumnSpacing="10" MinHeight="40">
                  <TextBlock Text="{Binding Number}" FontSize="10.5" Foreground="#8993A7" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SpotifyUrl}" FontSize="9" Foreground="#929BAE" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Artist}" FontSize="10.5" Foreground="#59657A" VerticalAlignment="Center" TextWrapping="NoWrap" MaxLines="1" />
                  <TextBlock Grid.Column="3" Text="{Binding Album}" FontSize="10.5" Foreground="#59657A" VerticalAlignment="Center" TextWrapping="NoWrap" MaxLines="1" />
                  <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="10" Foreground="#7B8699" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="5" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding YouTubeMatchDisplay}" FontSize="10.5" FontWeight="Medium" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{Binding YouTubeMatchChannel}" FontSize="9" Foreground="#929BAE" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  </StackPanel>
                  <Border Grid.Column="6" Background="#F2F4F8" CornerRadius="6" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding YouTubeMatchScoreText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#5C687E" TextWrapping="NoWrap" MaxLines="1" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" RowSpacing="11">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="FooterText" Text="Searching for audio-first matches…" FontSize="10.5" Foreground="#68758B" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="MatchCountText" Grid.Column="1" Text="0 / 0 tracks" FontSize="10.5" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" />
      </Grid>
      <ProgressBar x:Name="MatchProgress" Grid.Row="1" Height="6" Minimum="0" Maximum="100" Value="0" />
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="Only download material you own or are authorized to save." FontSize="9.5" Foreground="#8A93A3" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="secondary" Content="↗  Open YouTube match" Click="OpenYouTubeMatch_Click" />
        <Button Grid.Column="2" Classes="secondary" Content="↗  Open Spotify track" Click="OpenSelected_Click" />
        <Button Grid.Column="3" Classes="secondary" Content="Export CSV" Click="ExportCsv_Click" />
        <Button Grid.Column="4" Classes="primary" Content="Done" Click="Close_Click" MinWidth="80" />
      </Grid>
    </Grid>
  </Grid>
</Window>
