<Window x:Class="FlickFetch.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickFetch — Settings" Width="880" Height="740" MinWidth="730" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Opened="Window_Loaded" CanResize="True">
  <Grid Margin="22" RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="13">
      <Border Width="43" Height="43" CornerRadius="13" Background="#5B5CE2">
        <TextBlock Text="⚙" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="Preferences" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Fine-tune output, subtitles, connections, and the bundled downloader tools." FontSize="11.5" Foreground="#778198" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E7F0" BorderThickness="1" CornerRadius="15" Padding="10">
      <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="Format &amp; output">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,13,10,8">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Quality details" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="The custom format string is used when Custom format is selected on the main screen." FontSize="10.5" Foreground="#778198" />
                <TextBox x:Name="CustomFormatBox" Margin="0,4,0,0" />
              </StackPanel>
              <Grid ColumnDefinitions="*,14,*">
                <StackPanel Spacing="5"><TextBlock Text="AUDIO QUALITY" Classes="eyebrow"/><ComboBox x:Name="AudioQualityBox" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="FILE NAME TEMPLATE" Classes="eyebrow"/><TextBox x:Name="TemplateBox" /></StackPanel>
              </Grid>
              <Border Height="1" Background="#E9EDF4" Margin="0,4" />
              <TextBlock Text="Output behavior" FontSize="14" FontWeight="Bold" />
              <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                <CheckBox x:Name="RestrictCheck" Content="Safe ASCII file names" />
                <CheckBox x:Name="OverwriteCheck" Grid.Column="1" Content="Overwrite existing files" />
                <CheckBox x:Name="InfoJsonCheck" Grid.Column="2" Content="Save info JSON" />
                <CheckBox x:Name="DescriptionCheck" Grid.Row="1" Content="Save description" />
                <CheckBox x:Name="WriteThumbCheck" Grid.Row="1" Grid.Column="1" Content="Save thumbnail JPG" />
                <CheckBox x:Name="ArchiveCheck" Grid.Row="1" Grid.Column="2" Content="Skip archived videos" />
              </Grid>
              <Border Height="1" Background="#E9EDF4" Margin="0,4" />
              <StackPanel Spacing="4">
                <TextBlock Text="Download section (optional)" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="Use seconds, 1:30, or 00:01:30. Leave a field blank to use the beginning or end." FontSize="10.5" Foreground="#778198" />
              </StackPanel>
              <Grid ColumnDefinitions="*,14,*">
                <StackPanel Spacing="5"><TextBlock Text="START AT" Classes="eyebrow"/><TextBox x:Name="SectionStartBox" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="END AT" Classes="eyebrow"/><TextBox x:Name="SectionEndBox" /></StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Subtitles &amp; extras">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,13,10,8">
            <StackPanel Spacing="10">
              <TextBlock Text="Subtitles" FontSize="14" FontWeight="Bold" />
              <CheckBox x:Name="SubsCheck" Content="Download subtitles" />
              <CheckBox x:Name="AutoSubsCheck" Content="Include auto-generated subtitles" Margin="20,0,0,0" />
              <CheckBox x:Name="EmbedSubsCheck" Content="Embed subtitles into the video when possible" Margin="20,0,0,0" />
              <StackPanel Spacing="5" Margin="0,5,0,0"><TextBlock Text="SUBTITLE LANGUAGE EXPRESSION" Classes="eyebrow"/><TextBox x:Name="SubtitleLanguagesBox" /></StackPanel>
              <Border Height="1" Background="#E9EDF4" Margin="0,6" />
              <TextBlock Text="Metadata and enhancements" FontSize="14" FontWeight="Bold" />
              <CheckBox x:Name="ThumbCheck" Content="Embed thumbnail" />
              <CheckBox x:Name="MetadataCheck" Content="Embed metadata and chapters" />
              <CheckBox x:Name="SponsorCheck" Content="Remove detected sponsor segments (supported sources only)" />
              <Border Background="#F7F8FC" CornerRadius="9" Padding="12" Margin="0,4,0,0">
                <TextBlock Text="Some options require FFmpeg. Subtitle and SponsorBlock availability depends on the source site and the formats it provides." FontSize="10.5" Foreground="#778198" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Network &amp; login">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,13,10,8">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,14,*">
                <StackPanel Spacing="5"><TextBlock Text="COOKIES FROM BROWSER" Classes="eyebrow"/><ComboBox x:Name="BrowserBox" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="PROXY URL (OPTIONAL)" Classes="eyebrow"/><TextBox x:Name="ProxyBox" /></StackPanel>
              </Grid>
              <StackPanel Spacing="5"><TextBlock Text="COOKIES.TXT FILE" Classes="eyebrow"/>
                <Grid ColumnDefinitions="*,10,Auto"><TextBox x:Name="CookiesFileBox"/><Button Grid.Column="2" Classes="secondary" Content="Browse…" Click="BrowseCookies_Click" /></Grid>
              </StackPanel>
              <Border Height="1" Background="#E9EDF4" Margin="0,2" />
              <TextBlock Text="Transfer controls" FontSize="14" FontWeight="Bold" />
              <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                <StackPanel Spacing="5"><TextBlock Text="SPEED LIMIT (E.G. 2M)" Classes="eyebrow"/><TextBox x:Name="RateLimitBox" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="PARALLEL FRAGMENTS" Classes="eyebrow"/><ComboBox x:Name="FragmentsBox" /></StackPanel>
                <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="RETRY ATTEMPTS" Classes="eyebrow"/><ComboBox x:Name="RetriesBox" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="5"><TextBlock Text="SIMULTANEOUS DOWNLOADS" Classes="eyebrow"/><ComboBox x:Name="ParallelBox" /></StackPanel>
              </Grid>
              <Border Background="#F7F8FC" CornerRadius="9" Padding="12">
                <TextBlock Text="Only use browser cookies or cookie files for accounts you control. Credentials are read locally by yt-dlp." FontSize="10.5" Foreground="#778198" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="App &amp; tools">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,13,10,8">
            <StackPanel Spacing="10">
              <TextBlock Text="Behavior" FontSize="14" FontWeight="Bold" />
              <CheckBox x:Name="AutoStartCheck" Content="Start queued downloads automatically" />
              <CheckBox x:Name="ClipboardCheck" Content="Watch clipboard for copied media links" />
              <CheckBox x:Name="AutoUpdateCheck" Content="Check for yt-dlp updates on startup" />
              <Border Height="1" Background="#E9EDF4" Margin="0,4" />
              <TextBlock Text="Extra yt-dlp arguments" FontSize="14" FontWeight="Bold" />
              <TextBlock Text="Optional arguments appended to every yt-dlp command. Use only options you understand." FontSize="10.5" Foreground="#778198" />
              <TextBox x:Name="ExtraArgsBox" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
              <Border Height="1" Background="#E9EDF4" Margin="0,4" />
              <TextBlock Text="Downloader tools" FontSize="14" FontWeight="Bold" />
              <TextBlock x:Name="ToolsStatusText" Text="Tool directory" FontSize="10.5" Foreground="#778198" />
              <ProgressBar x:Name="ToolsProgress" Minimum="0" Maximum="100" Value="0" IsVisible="False" />
              <Grid ColumnDefinitions="*,10,*">
                <Button Classes="secondary" Content="Update yt-dlp" Click="UpdateYtDlp_Click" />
                <Button Grid.Column="2" Classes="secondary" Content="Install / reinstall tools" Click="ReinstallTools_Click" />
              </Grid>
              <Button Classes="quiet" HorizontalAlignment="Left" Content="Show tool versions" Click="ShowVersions_Click" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
      <TextBlock Text="Changes are saved locally to this Windows profile." FontSize="10.5" Foreground="#8590A4" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="secondary" Content="Cancel" Click="Cancel_Click" MinWidth="90" />
      <Button Grid.Column="2" Classes="primary" Content="Save settings" Click="Save_Click" MinWidth="120" />
    </Grid>
  </Grid>
</Window>
