<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <UseAvalonia>true</UseAvalonia>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FlickFetch</RootNamespace>
    <AssemblyName>FlickFetch</AssemblyName>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <AssemblyTitle>FlickFetch</AssemblyTitle>
    <Product>FlickFetch</Product>
    <Authors>Jessie Albert Regualos</Authors>
    <Company>Jessie Albert Regualos</Company>
    <Copyright>Copyright © 2026 Jessie Albert Regualos</Copyright>
    <Description>FlickFetch is an Avalonia desktop media download manager built around yt-dlp.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Diagnostics" Version="12.1.4" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md">
      <LogicalName>FlickFetch.THIRD-PARTY-NOTICES.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\BundledTools\yt-dlp.exe" Condition="Exists('Assets\BundledTools\yt-dlp.exe')">
      <LogicalName>FlickFetch.BundledTools.yt-dlp.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\BundledTools\ffmpeg.exe" Condition="Exists('Assets\BundledTools\ffmpeg.exe')">
      <LogicalName>FlickFetch.BundledTools.ffmpeg.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\BundledTools\ffprobe.exe" Condition="Exists('Assets\BundledTools\ffprobe.exe')">
      <LogicalName>FlickFetch.BundledTools.ffprobe.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\BundledTools\deno.exe" Condition="Exists('Assets\BundledTools\deno.exe')">
      <LogicalName>FlickFetch.BundledTools.deno.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\BundledTools\bundled-tools-manifest.txt" Condition="Exists('Assets\BundledTools\bundled-tools-manifest.txt')">
      <LogicalName>FlickFetch.BundledTools.manifest.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
